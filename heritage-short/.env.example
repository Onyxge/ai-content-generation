# Copy to .env and fill in. .env is gitignored; never commit keys.
GEMINI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Kaggle CLI 2.x (checked 2026-11-26) no longer accepts the old username/key pair: generate an API token
# at kaggle.com/settings/api ("Generate New Token") and put it here. Lets `film` push GPU bundles itself.
KAGGLE_API_TOKEN=

# Addis AI (Amharic voice and checks, optional; see docs/01-plan.md)
ADDIS_AI_API_KEY=
